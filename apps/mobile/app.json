{
  "expo": {
    "name": "BookSpot",
    "slug": "bookspot",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bookspot",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.bookspot.app",
      "buildNumber": "1",
      "supportsTablet": false,
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "LSApplicationQueriesSchemes": [
          "comgooglemaps",
          "waze",
          "yandexmaps",
          "yandexnavi"
        ]
      }
    },
    "android": {
      "package": "com.bookspot.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2563EB",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Photo access is needed to upload photos of the salon and its masters.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2563EB"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Location is used to show salons near you and to mark your salon on the map."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "dc12ae3c-45be-4b2f-be5b-a9ee9f74339f"
      }
    },
    "owner": "nagiev217",
    "locales": {
      "az": "./locales/az.json",
      "ru": "./locales/ru.json",
      "en": "./locales/en.json"
    }
  }
}
